# ═══════════════════════════════════════════════════════════
# GENI - AI Elder Care System - Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and add your API keys

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# Patient Configuration
PATIENT_NAME=Margaret Johnson
CAREGIVER_PHONE=+1234567890

# ═══════════════════════════════════════════════════════════
# AI API KEYS (REQUIRED)
# ═══════════════════════════════════════════════════════════

# Anthropic Claude API (Vision + Chat)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API (Whisper for voice transcription)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=whisper-1

# ═══════════════════════════════════════════════════════════
# OPTIONAL INTEGRATIONS
# ═══════════════════════════════════════════════════════════

# Twilio WhatsApp (Free sandbox: https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
GENI_ENABLE_MESSAGING=false
GENI_ENABLE_FALL_DETECTION=false
GENI_FALL_DETECTION_MODE=frame
ANTHROPIC_VISION_MODEL=claude-3-5-haiku-20241022

# ElevenLabs TTS (Optional but recommended for better voice quality)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Voice ID: Rachel - warm, natural female voice (default)

# ═══════════════════════════════════════════════════════════
# CORS & Security
# ═══════════════════════════════════════════════════════════
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Configuration
API_PREFIX=/api
VITE_API_URL=http://localhost:5000
